  - family-names: "Senouci"
    given-names: "Benaoumeur"
    affiliation: "University of Southern Denmark"
    email: "senouci@sdu.dk"
keywords:
  - large language models
  - embedded systems
  - code generation
  - hardware-aware programming
  - Raspberry Pi
  - fine-tuning
  - dataset
license: CC-BY-4.0

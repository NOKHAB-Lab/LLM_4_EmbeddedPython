# Google Gemini (Generative Language API) keys, comma-separated.
# Get keys at https://aistudio.google.com/app/apikey
# The pipeline rotates across these to spread rate limits.
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3

# Optional: generation model (default gemini-2.5-flash, which has free-tier quota).
# NOTE: gemini-2.0-flash no longer has a free tier (returns 429 limit:0).
GEMINI_MODEL=gemini-2.5-flash
